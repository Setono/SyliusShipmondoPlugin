{% extends '@SyliusAdmin/layout.html.twig' %}

{% import '@SyliusUi/Macro/headers.html.twig' as headers %}

{% set header = 'setono_sylius_shipmondo.ui.shipmondo'|trans %}

{% block title %}{{ header }} {{ parent() }}{% endblock %}

{% block content %}
    <div class="column">
        {{ headers.default(header, 'truck', 'setono_sylius_shipmondo.ui.shipmondo_index'|trans) }}
    </div>

    <div class="ui hidden divider"></div>

    <div class="ui grid">
        <div class="eight wide column">
            <div class="ui segment">
                <h4 class="ui header">{{ 'setono_sylius_shipmondo.ui.map_payment_methods'|trans }}</h4>

                {% if stalePaymentGateways|length > 0 %}
                    <div class="ui warning message">
                        <p>{{ 'setono_sylius_shipmondo.ui.stale_payment_gateways'|trans }}</p>
                        <ul class="list">
                            {% for paymentMethod in stalePaymentGateways %}
                                <li>{{ paymentMethod.name }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# a stale mapping stays removable, also when Shipmondo has no payment gateway left #}
                {% if shipmondoPaymentMethods|length > 0 or stalePaymentGateways|length > 0 %}
                    <form method="post">
                        <p>{{ (shipmondoPaymentMethods|length > 0 ? 'setono_sylius_shipmondo.ui.map_payment_methods_information' : 'setono_sylius_shipmondo.ui.map_payment_methods_empty_information')|trans|raw }}</p>
                        <table class="ui celled table">
                            <thead>
                            <tr>
                                <th>{{ 'setono_sylius_shipmondo.ui.payment_method_in_sylius'|trans }}</th>
                                <th>{{ 'setono_sylius_shipmondo.ui.payment_method_in_shipmondo'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for paymentMethod in paymentMethods %}
                                <tr{% if stalePaymentGateways[paymentMethod] is defined %} class="warning"{% endif %}>
                                    <td>{{ paymentMethod.name }}</td>
                                    <td>
                                        <select name="payment_methods[{{ paymentMethod.id }}]" class="ui dropdown">
                                            <option value="">{{ 'setono_sylius_shipmondo.ui.select_shipmondo_payment_method'|trans }}</option>
                                            {% for shipmondoPaymentMethod in shipmondoPaymentMethods %}
                                                <option value="{{ shipmondoPaymentMethod.id }}" {% if shipmondoPaymentMethod.id == paymentMethod.shipmondoId %}selected{% endif %}>{{ shipmondoPaymentMethod.name }}</option>
                                            {% endfor %}
                                            {# a mapping to a payment gateway that no longer exists in Shipmondo is kept until the admin removes it #}
                                            {% if stalePaymentGateways[paymentMethod] is defined %}
                                                <option value="{{ stalePaymentGateways[paymentMethod] }}" selected>{{ 'setono_sylius_shipmondo.ui.not_in_shipmondo'|trans({'%id%': stalePaymentGateways[paymentMethod]}) }}</option>
                                            {% endif %}
                                        </select>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        <button type="submit" class="ui primary button">{{ 'sylius.ui.save_changes'|trans }}</button>
                    </form>
                {% else %}
                    <p>{{ 'setono_sylius_shipmondo.ui.map_payment_methods_empty_information'|trans|raw }}</p>
                {% endif %}
            </div>
        </div>
        <div class="eight wide column">
            <div class="ui segment">
                <h4 class="ui header">{{ 'setono_sylius_shipmondo.ui.webhooks'|trans }}</h4>

                {% if registeredWebhooks is null %}
                    <p>{{ 'setono_sylius_shipmondo.ui.register_webhooks_information'|trans }}</p>
                {% else %}
                    <p>{{ 'setono_sylius_shipmondo.ui.webhooks_registered_information'|trans({'%date%': registeredWebhooks.registeredAt|date}) }}</p>
                {% endif %}
                <a href="{{ path('setono_sylius_shipmondo_admin_shipmondo_register_webhooks') }}" class="ui primary button">
                    {{ 'setono_sylius_shipmondo.ui.register_webhooks'|trans }}
                </a>
            </div>
        </div>
    </div>
    <div class="ui grid">
        <div class="sixteen wide column">
            <div class="ui segment">
                <h4 class="ui header">{{ 'setono_sylius_shipmondo.ui.map_shipping_methods'|trans }}</h4>

                {% if staleShipmentTemplates|length > 0 %}
                    <div class="ui warning message">
                        <p>{{ 'setono_sylius_shipmondo.ui.stale_shipment_templates'|trans }}</p>
                        <ul class="list">
                            {% for shippingMethod in staleShipmentTemplates %}
                                <li>{{ shippingMethod.name }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# a stale mapping stays removable, also when Shipmondo has no shipment template left #}
                {% if shipmondoShipmentTemplates|length > 0 or staleShipmentTemplates|length > 0 %}
                    <form method="post">
                        <p>{{ (shipmondoShipmentTemplates|length > 0 ? 'setono_sylius_shipmondo.ui.map_shipping_methods_information' : 'setono_sylius_shipmondo.ui.map_shipping_methods_empty_information')|trans|raw }}</p>
                        <table class="ui single line celled table">
                            <thead>
                            <tr>
                                <th>{{ 'setono_sylius_shipmondo.ui.shipping_method_in_sylius'|trans }}</th>
                                <th>{{ 'setono_sylius_shipmondo.ui.shipment_templates_in_shipmondo'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for shippingMethod in shippingMethods %}
                                <tr{% if staleShipmentTemplates[shippingMethod] is defined %} class="warning"{% endif %}>
                                    <td>{{ shippingMethod.name }}</td>
                                    <td>
                                        {# a select without a selected shipment template isn't submitted, so this says which shipping methods the form lists #}
                                        <input type="hidden" name="listed_shipping_methods[]" value="{{ shippingMethod.id }}">
                                        <select name="shipping_methods[{{ shippingMethod.id }}][]" class="ui fluid search dropdown" multiple>
                                            {% for shipmondoShipmentTemplate in shipmondoShipmentTemplates %}
                                                <option value="{{ shipmondoShipmentTemplate.id }}" {% if shippingMethod.hasAllowedShipmentTemplate(shipmondoShipmentTemplate) %}selected{% endif %}>{{ shipmondoShipmentTemplate.name }}</option>
                                            {% endfor %}
                                            {# an allowed shipment template that no longer exists in Shipmondo is kept until the admin removes it #}
                                            {% for allowedShipmentTemplate in staleShipmentTemplates[shippingMethod] ?? [] %}
                                                <option value="{{ allowedShipmentTemplate }}" selected>{{ 'setono_sylius_shipmondo.ui.not_in_shipmondo'|trans({'%id%': allowedShipmentTemplate}) }}</option>
                                            {% endfor %}
                                        </select>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        <button type="submit" class="ui primary button">{{ 'sylius.ui.save_changes'|trans }}</button>
                    </form>
                {% else %}
                    <p>{{ 'setono_sylius_shipmondo.ui.map_shipping_methods_empty_information'|trans|raw }}</p>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(() => {
            $('.ui.dropdown').dropdown({
                fullTextSearch: true,
                match: 'text',
                // a single dropdown shows its empty choice only as placeholder text, so a clear icon empties it (a
                // multiple one removes its labels instead)
                clearable: true
            });
        });
    </script>
{% endblock %}
