{# Shown by the pickup point picker instead of the pickup points when they could not be loaded. Like the pickup points, it is a .pickup-points-container, which the picker removes when they are loaded again; it loads them again when the button with data-pickup-point-manager-load-again in it is clicked #}
<div class="item pickup-points-container">
    <div class="field" style="width: 17px">&nbsp;</div>
    <div class="content">
        <div class="ui negative message">
            <p>{{ 'setono_sylius_shipmondo.ui.pickup_points_not_loaded'|trans }}</p>
            <button type="button" class="ui small button" data-pickup-point-manager-load-again>{{ 'setono_sylius_shipmondo.ui.try_again'|trans }}</button>
        </div>
    </div>
</div>
