<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://symfony.com/schema/dic/services"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="Setono\SyliusShipmondoPlugin\Provider\PreQualifiedUploadableOrdersProvider">
            <argument type="service" id="sylius.repository.order"/>
            <argument type="service" id="event_dispatcher"/>
        </service>

        <service id="Setono\SyliusShipmondoPlugin\Provider\PreQualifiedUploadableOrdersProviderInterface"
                 alias="Setono\SyliusShipmondoPlugin\Provider\PreQualifiedUploadableOrdersProvider"/>

        <service id="Setono\SyliusShipmondoPlugin\Provider\UnlinkedOrdersProvider">
            <argument type="service" id="sylius.repository.order"/>
        </service>

        <service id="Setono\SyliusShipmondoPlugin\Provider\UnlinkedOrdersProviderInterface"
                 alias="Setono\SyliusShipmondoPlugin\Provider\UnlinkedOrdersProvider"/>

        <service id="Setono\SyliusShipmondoPlugin\Provider\OrderIdProvider"/>

        <service id="Setono\SyliusShipmondoPlugin\Provider\SetupProvider">
            <argument type="service" id="Setono\Shipmondo\Client\Client"/>

            <!-- forgets the payment gateways and shipment templates it fetched between requests and messages -->
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Setono\SyliusShipmondoPlugin\Provider\SetupProviderInterface"
                 alias="Setono\SyliusShipmondoPlugin\Provider\SetupProvider"/>
    </services>
</container>
