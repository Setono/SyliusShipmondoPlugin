# Environment for the Playwright end-to-end tests (tests/Playwright), loaded when APP_ENV=e2e.
# Put machine-specific overrides (e.g. another DATABASE_URL) in an untracked .env.e2e.local.

# A database of its own: the suite loads fixtures into it and changes data
DATABASE_URL=mysql://root@127.0.0.1/setono_sylius_shipmondo_e2e?serverVersion=5.7

# The e2e environment stubs the Shipmondo HTTP transport (config/services_e2e.yaml), so these are never sent
SHIPMONDO_USERNAME=e2e
SHIPMONDO_KEY=e2e
SHIPMONDO_WEBHOOKS_KEY=e2e_dummy_webhooks_key_at_least_32_bytes
SHIPMONDO_SANDBOX=true
